# ============================================================================
# CHITTRUST + CASHBRIDGE ENVIRONMENT CONFIGURATION TEMPLATE
# ============================================================================

# 1. PUBLIC FRONTEND VARIABLES (Next.js - Safe to expose to browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your_razorpay_key_id
NEXT_PUBLIC_API_URL=https://chittrust-cashbridge.onrender.com/api/v1

# 2. SERVER BACKEND VARIABLES (FastAPI - NEVER expose publicly!)
ENVIRONMENT=production
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:3000","https://chittrust-cashbridge.onrender.com"]

# Supabase Real Database Keys
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Payment Integration (Razorpay Test Mode / Live)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Voice IVR & Telephony Integration (Twilio)
VOICE_PROVIDER=twilio
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# AI Intelligence Integration (Groq API)
GROQ_API_KEY=gsk_your_groq_api_key_here

