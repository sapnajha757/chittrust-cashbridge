# ============================================================================
# CHITTRUST + CASHBRIDGE ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to .env.local (Frontend) and backend/.env (Backend)
# ============================================================================

# 1. PUBLIC FRONTEND VARIABLES (Next.js)
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your_key_id
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000

# 2. SERVER BACKEND VARIABLES (FastAPI - Never expose publicly!)
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# 3. DEMO MODE & SECURITY CONFIGURATION
DEMO_MODE=true
ENVIRONMENT=development

# 4. PAYMENT PROVIDER (Razorpay Test Mode)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# 5. TELEPHONY & VOICE PROVIDER (mock / twilio / exotel)
VOICE_PROVIDER=mock
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
EXOTEL_SID=your_exotel_sid
EXOTEL_TOKEN=your_exotel_token

# 6. NOTIFICATION DISPATCHER (in_app / sms / voice)
NOTIFICATION_PROVIDER=mock
